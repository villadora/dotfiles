#!/bin/bash
#
# bootstrap installs things.
# Idempotent: safe to re-run if interrupted.

# Resolve script path (handles symlinks)
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
    SOURCE="$( readlink "$SOURCE" )"
    [ -n "$DIR" ] && SOURCE="$DIR/$SOURCE"
done
DOTFILES_ROOT="$( cd -P "$( dirname "$SOURCE" )" && pwd )"

echo ''

info () {
  printf "  [ \033[00;34m..\033[0m ] $1"
}

user () {
  printf "\r  [ \033[0;33m?\033[0m ] $1 "
}

success () {
  printf "\r\033[2K  [ \033[00;32mOK\033[0m ] $1\n"
}

fail () {
  printf "\r\033[2K  [\033[0;31mFAIL\033[0m] $1\n"
  echo ''
}

# Run a command, continue on failure
run () {
  "$@" 2>&1 && return 0
  fail "$*"
  return 1
}

# Global action flags
action_overwrite_all=false
action_backup_all=false
action_skip_all=false
action_upgrade_all=false
action_upgrade_git_all=false
action_upgrade_brew_all=false
action_no_all=false

setup_gitconfig () {
  if ! [ -f "$DOTFILES_ROOT/git/gitconfig.symlink" ]; then
    info 'setup gitconfig'
    user ' - What is your github author name?'
    read -e git_authorname
    user ' - What is your github author email?'
    read -e git_authoremail

    sed -e "s/AUTHORNAME/$git_authorname/g" -e "s/AUTHOREMAIL/$git_authoremail/g" "$DOTFILES_ROOT/git/gitconfig.symlink.example" > "$DOTFILES_ROOT/git/gitconfig.symlink"
    success 'gitconfig'
  else
    info 'gitconfig already exists, skipping'
    success 'gitconfig'
  fi
}

link_files () {
  ln -s "$1" "$2"
  success "linked $1 to $2"
}

install_dotfiles () {
  info 'installing dotfiles'

  # Only ask once for all existing files
  if [ "$action_overwrite_all" == "false" ] && [ "$action_backup_all" == "false" ] && [ "$action_skip_all" == "false" ]; then
    user "File already exists, what do you want to do? [s]kip all, [o]verwrite all, [b]ackup all: "
    read -n 1 action
    echo ''

    case "$action" in
      o|O) action_overwrite_all=true;;
      b|B) action_backup_all=true;;
      s|S|*) action_skip_all=true;;
    esac
  fi

  for source in `find $DOTFILES_ROOT -maxdepth 2 -name \*.symlink`
  do
    dest="$HOME/.`basename \"${source%.*}\"`"

    if [ -f "$dest" ] || [ -d "$dest" ]; then
      if [ "$action_overwrite_all" == "true" ]; then
        rm -rf "$dest"
        success "removed $dest"
        link_files "$source" "$dest"
      elif [ "$action_backup_all" == "true" ]; then
        mv "$dest" "$dest.backup"
        success "moved $dest to $dest.backup"
        link_files "$source" "$dest"
      elif [ "$action_skip_all" == "true" ]; then
        success "skipped $source"
      else
        link_files "$source" "$dest"
      fi
    else
      link_files "$source" "$dest"
    fi
  done
}

install_tmux_conf_local() {
  if ! [ -f "$HOME/.tmux.conf.local" ]; then
    info "Create ~/.tmux.conf.local"
    touch "$HOME/.tmux.conf.local"
    success 'tmux.conf.local'
  fi
}

install_homebrew() {
  if ! command -v brew >/dev/null 2>&1; then
    info "Install Homebrew"
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    success 'homebrew'
  else
    info 'homebrew already installed, skipping'
    success 'homebrew'
  fi
}

# Unified upgrade check for all installed software
# Called once before processing any installed items
ask_upgrade_all() {
  if [ "$action_upgrade_all" == "false" ] && [ "$action_no_all" == "false" ]; then
    info "Checking installed software..."
    user "Upgrade all? [y]es, [n]o, [N]o for all, [p]artial (brew), [g]it only: "
    read -n 1 confirm 2>/dev/null || confirm="n"
    echo ''

    case "$confirm" in
      y|Y) action_upgrade_git_all=true; action_upgrade_brew_all=true;;
      p|P) action_upgrade_git_all=false; action_upgrade_brew_all=true;;
      g|G) action_upgrade_git_all=true; action_upgrade_brew_all=false;;
      N) action_no_all=true; action_upgrade_git_all=false; action_upgrade_brew_all=false;;
      *) action_upgrade_git_all=false; action_upgrade_brew_all=false;;
    esac
    action_upgrade_all=true
  fi
}

git_upgrade() {
  local path="$1"
  local name="$2"

  if [ "$action_upgrade_git_all" == "true" ]; then
    (cd "$path" && git pull origin master 2>/dev/null) && success "  $name upgraded" || fail "  $name upgrade failed"
    return 0
  fi

  if [ "$action_no_all" == "true" ]; then
    success "  $name skipped"
    return 0
  fi

  info "  $name already installed"
  user "  - Upgrade $name? [y]es, [n]o, [N]o for all: "
  read -n 1 confirm 2>/dev/null || confirm="n"
  echo ''

  case "$confirm" in
    y|Y)
      (cd "$path" && git pull origin master 2>/dev/null) && success "  $name upgraded" || fail "  $name upgrade failed"
      ;;
    N)
      action_no_all=true
      success "  $name skipped"
      ;;
    *)
      success "  $name skipped"
      ;;
  esac
}

brew_upgrade() {
  local pkg="$1"
  local is_cask="${2:-false}"

  if [ "$action_upgrade_brew_all" == "true" ]; then
    if [ "$is_cask" = "true" ]; then
      brew upgrade --cask "$pkg" && success "  $pkg upgraded" || fail "  $pkg upgrade failed"
    else
      brew upgrade "$pkg" && success "  $pkg upgraded" || fail "  $pkg upgrade failed"
    fi
    return 0
  fi

  if [ "$action_no_all" == "true" ]; then
    success "  $pkg skipped"
    return 0
  fi

  info "  $pkg already installed"
  user "  - Upgrade $pkg? [y]es, [n]o, [N]o for all: "
  read -n 1 confirm 2>/dev/null || confirm="n"
  echo ''

  case "$confirm" in
    y|Y)
      if [ "$is_cask" = "true" ]; then
        brew upgrade --cask "$pkg" && success "  $pkg upgraded" || fail "  $pkg upgrade failed"
      else
        brew upgrade "$pkg" && success "  $pkg upgraded" || fail "  $pkg upgrade failed"
      fi
      ;;
    N)
      action_no_all=true
      success "  $pkg skipped"
      ;;
    *)
      success "  $pkg skipped"
      ;;
  esac
}

install_oh_my_zsh() {
  if ! [ -d "$HOME/.oh-my-zsh" ]; then
    info "Install Oh My Zsh"
    sh -c "$(curl -fsSL https://raw.github.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
    success 'oh-my-zsh'
  else
    ask_upgrade_all
    git_upgrade "$HOME/.oh-my-zsh" "oh-my-zsh"
  fi
}

install_pyenv() {
  if ! [ -d "$HOME/.pyenv" ]; then
    info "Install pyenv"
    git clone https://github.com/pyenv/pyenv.git "$HOME/.pyenv" --quiet
    success 'pyenv'
  else
    ask_upgrade_all
    git_upgrade "$HOME/.pyenv" "pyenv"
  fi
}

setup_python_env() {
  info "Setup Python environment"

  # Check if pyenv is available
  if ! command -v pyenv >/dev/null 2>&1; then
    info "pyenv not in PATH, skipping Python setup"
    return 0
  fi

  # Show current Python environment status
  if [ -n "$(pyenv versions --bare 2>/dev/null)" ]; then
    info "Installed Python versions:"
    pyenv versions --bare 2>/dev/null | while read v; do
      info "  - $v"
    done
  fi

  local current_py=$(pyenv global 2>/dev/null)
  if [ -n "$current_py" ] && [ "$current_py" != "system" ]; then
    info "Current global Python: $current_py"
    info "Python already configured, skipping"
    return 0
  fi

  # Install default Python version
  info "Installing default Python 3.12.0"
  if pyenv install 3.12.0 2>&1; then
    pyenv global 3.12.0
    success "Python 3.12.0 installed"
  else
    fail "Failed to install Python"
  fi
}

install_jenv() {
  if ! [ -d "$HOME/.jenv" ]; then
    info "Install jenv"
    git clone https://github.com/jenv/jenv.git "$HOME/.jenv" --quiet
    success 'jenv'
  else
    ask_upgrade_all
    git_upgrade "$HOME/.jenv" "jenv"
  fi
}

install_nvm() {
  if ! [ -f "$HOME/.nvm/nvm.sh" ]; then
    info "Install NVM"
    export NVM_DIR="$HOME/.nvm"
    mkdir -p "$NVM_DIR"
    git clone https://github.com/nvm-sh/nvm.git "$HOME/.nvm" --branch v0.40.3 --single-branch --quiet
    success 'nvm'
  else
    ask_upgrade_all
    git_upgrade "$HOME/.nvm" "nvm"
  fi
}

install_tmux_plugins() {
  if ! [ -f "$HOME/.tmux/plugins/tpm/tpm" ]; then
    info "Install TPM"
    git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm --quiet
    success 'tpm'
  else
    ask_upgrade_all
    git_upgrade "$HOME/.tmux/plugins/tpm" "tpm"
  fi

  # Install tmux plugins
  local tpm_plugins=(
    "tmux-resurrect"
    "tmux-continuum"
    "tmux-open"
    "tmux-yank"
    "tmux-logging"
  )

  for plugin in "${tpm_plugins[@]}"; do
    if ! [ -d "$HOME/.tmux/plugins/$plugin" ]; then
      info "  Install $plugin"
      git clone "https://github.com/tmux-plugins/$plugin" "$HOME/.tmux/plugins/$plugin" --quiet && success "  $plugin" || fail "  $plugin"
    else
      success "  $plugin already installed"
    fi
  done
}

# Check if app is installed (works for both Homebrew and direct downloads)
is_app_installed() {
  local app_name="$1"

  for path in "/Applications/${app_name}.app" "$HOME/Applications/${app_name}.app" "/opt/homebrew/${app_name}.app" "$HOME/opt/homebrew/${app_name}.app"; do
    if [ -d "$path" ]; then
      return 0
    fi
  done

  return 1
}

install_via_brew() {
  info "Install packages via brew"

  for pkg in z git-extras newman tree; do
    if brew list "$pkg" >/dev/null 2>&1; then
      ask_upgrade_all
      brew_upgrade "$pkg" false
    else
      info "  installing $pkg"
      brew install "$pkg" && success "  $pkg installed" || fail "  $pkg failed"
    fi
  done
}

install_homebrew_taps() {
  info "Install Homebrew taps"
  if ! brew tap | grep -q "farion1231/ccswitch"; then
    brew tap farion1231/ccswitch && success "  ccswitch tap" || fail "  ccswitch tap failed"
  else
    info "  ccswitch tap already exists, skipping"
  fi
}

install_ccswitch() {
  info "Install ccswitch"

  # Check if tap exists, if not add it
  if ! brew tap | grep -q "farion1231/ccswitch"; then
    brew tap farion1231/ccswitch || { fail "  ccswitch tap failed"; return 1; }
  fi

  # Check if package is installed (cask name is cc-switch with hyphen)
  if brew list --cask cc-switch >/dev/null 2>&1; then
    ask_upgrade_all
    brew_upgrade "cc-switch" true
  else
    # Try to install cc-switch
    if brew install cc-switch 2>/dev/null; then
      success "  cc-switch installed"
    else
      # Check if it's actually installed now
      if brew list --cask cc-switch >/dev/null 2>&1; then
        success "  cc-switch already installed"
      else
        fail "  cc-switch failed"
      fi
    fi
  fi
}

install_brew_packages() {
  info "Install core packages via brew"

  local packages=(
    "python@3.13"
    "maven"
    "gradle"
    "cmake"
  )

  for pkg in "${packages[@]}"; do
    if brew list "$pkg" >/dev/null 2>&1; then
      ask_upgrade_all
      brew_upgrade "$pkg" false
    else
      info "  installing $pkg"
      brew install "$pkg" && success "  $pkg installed" || fail "  $pkg failed"
    fi
  done
}

install_brew_casks() {
  info "Install cask applications"

  local casks=(
    "warp"
    "docker-desktop"
  )

  for pkg in "${casks[@]}"; do
    # Special handling for docker-desktop: check both brew and direct app installation
    if [ "$pkg" = "docker-desktop" ]; then
      if brew list --cask "$pkg" >/dev/null 2>&1; then
        ask_upgrade_all
        brew_upgrade "$pkg" true
      elif is_app_installed "Docker"; then
        info "  Docker Desktop already installed (direct), skipping"
        continue
      else
        info "  installing $pkg"
        brew install --cask "$pkg" && success "  $pkg installed" || fail "  $pkg failed"
      fi
    else
      if brew list --cask "$pkg" >/dev/null 2>&1; then
        ask_upgrade_all
        brew_upgrade "$pkg" true
      else
        info "  installing $pkg"
        brew install --cask "$pkg" && success "  $pkg installed" || fail "  $pkg failed"
      fi
    fi
  done
}

install_gemini_cli() {
  info "Install Gemini CLI"
  if brew list gemini-cli >/dev/null 2>&1; then
    ask_upgrade_all
    brew_upgrade "gemini-cli" false
  else
    brew install gemini-cli && success "  gemini-cli installed" || fail "  gemini-cli failed"
  fi
}

install_mole() {
  info "Install mole"
  if brew list mole >/dev/null 2>&1; then
    ask_upgrade_all
    brew_upgrade "mole" false
  else
    brew install mole && success "  mole installed" || fail "  mole failed"
  fi
}

install_emacs_spacemacs() {
  info "Install Emacs with Spacemacs"

  # Check if emacs is installed
  if command -v emacs >/dev/null 2>&1; then
    ask_upgrade_all
    if [ "$action_upgrade_brew_all" == "true" ]; then
      brew upgrade emacs && success "  emacs upgraded" || fail "  emacs upgrade failed"
    elif [ "$action_no_all" == "true" ]; then
      success "  emacs skipped"
    else
      info "  Emacs already installed"
      user "  - Upgrade emacs? [y]es, [n]o, [N]o for all: "
      read -n 1 confirm 2>/dev/null || confirm="n"
      echo ''
      case "$confirm" in
        y|Y) brew upgrade emacs && success "  emacs upgraded" || fail "  emacs upgrade failed" ;;
        N) action_no_all=true; success "  emacs skipped" ;;
        *) success "  emacs skipped" ;;
      esac
    fi
  else
    brew install emacs && success "  emacs installed" || { fail "  emacs failed"; return 1; }
  fi

  # Initialize Spacemacs if not already configured
  if [ ! -d "$HOME/.emacs.d" ]; then
    info "  Cloning Spacemacs"
    git clone https://github.com/syl20bnr/spacemacs ~/.emacs.d --branch develop --depth 1 && success "  spacemacs cloned" || { fail "  spacemacs clone failed"; return 1; }
  else
    info "  Spacemacs already configured"
    success "  spacemacs skipped"
  fi

  # Link spacemacs.el config with Tsinghua ELPA mirror
  if [ -f "$DOTFILES_ROOT/spacemacs.el" ]; then
    ln -sf "$DOTFILES_ROOT/spacemacs.el" "$HOME/.spacemacs.el" && success "  spacemacs.el linked" || fail "  spacemacs.el link failed"
  fi

  success "  emacs + spacemacs ready"
}

install_reattach_to_user_namespace() {
  info "Install reattach-to-user-namespace"
  if brew list reattach-to-user-namespace >/dev/null 2>&1; then
    ask_upgrade_all
    brew_upgrade "reattach-to-user-namespace" false
  else
    brew install reattach-to-user-namespace && success "  reattach-to-user-namespace installed" || fail "  reattach-to-user-namespace failed"
  fi
}

install_git_hooks() {
  info "Setup git hooks"

  local hooks_dir="$HOME/.config/git/hooks"
  local hooks_target="$DOTFILES_ROOT/git/hooks"

  if [ -L "$hooks_dir" ]; then
    local current_target="$(readlink -f "$hooks_dir")"
    if [ "$current_target" = "$(readlink -f "$hooks_target")" ]; then
      success "  git hooks already linked"
      return 0
    fi
    rm -f "$hooks_dir"
  elif [ -d "$hooks_dir" ]; then
    rm -rf "$hooks_dir"
  fi

  ln -sf "$hooks_target" "$hooks_dir" && success "  git hooks linked" || { fail "  git hooks link failed"; return 1; }
}

# Run installations in order
setup_gitconfig
install_git_hooks
install_dotfiles
install_tmux_conf_local
install_homebrew
install_oh_my_zsh
install_pyenv
setup_python_env
install_jenv
install_nvm
install_tmux_plugins
install_via_brew
install_brew_packages
install_brew_casks
install_emacs_spacemacs
install_reattach_to_user_namespace
install_homebrew_taps
install_ccswitch
install_gemini_cli
install_mole

echo ''
echo '  All installed!'