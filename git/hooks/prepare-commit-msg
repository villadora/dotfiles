#!/bin/bash
# prepare-commit-msg
# 如果用户没有写 commit message，自动用 claude -p 生成一条
#
# 安装：
#   cp prepare-commit-msg .git/hooks/prepare-commit-msg
#   chmod +x .git/hooks/prepare-commit-msg
#
# 团队共享：
#   cp prepare-commit-msg .githooks/prepare-commit-msg
#   chmod +x .githooks/prepare-commit-msg
#   git config core.hooksPath .githooks

COMMIT_MSG_FILE="$1"   # git 传入的临时文件路径
COMMIT_SOURCE="$2"     # commit 来源：message / template / merge / squash / commit

# ── 跳过条件 ──────────────────────────────────────────────────────────────
# merge / squash / cherry-pick 等有自动消息的场景，不覆盖
if [ "$COMMIT_SOURCE" = "merge" ] || \
   [ "$COMMIT_SOURCE" = "squash" ] || \
   [ "$COMMIT_SOURCE" = "commit" ]; then
  exit 0
fi

# 读取文件内容，去掉注释行（# 开头）和空行
EXISTING=$(grep -v '^#' "$COMMIT_MSG_FILE" | grep -v '^[[:space:]]*$')

# 用户已经写了内容，不覆盖
if [ -n "$EXISTING" ]; then
  exit 0
fi

# 没有暂存文件时跳过
STAGED=$(git diff --cached --name-only 2>/dev/null)
if [ -z "$STAGED" ]; then
  exit 0
fi

# claude 不存在时静默跳过，不影响正常 commit
if ! command -v claude &>/dev/null; then
  exit 0
fi

# ── 生成 commit message ───────────────────────────────────────────────────
DIFF=$(git diff --cached 2>/dev/null)

# diff 太大时只用 stat，避免超出 token
DIFF_SIZE=$(echo "$DIFF" | wc -c)
if [ "$DIFF_SIZE" -gt 20000 ]; then
  DIFF=$(git diff --cached --stat 2>/dev/null)
fi

MSG=$(echo "$DIFF" | claude -p \
  "根据以下 git diff 生成一条 commit message。

规则：
- 使用 Conventional Commits 格式：<type>(<scope>): <subject>
- type 从以下选择：feat / fix / docs / style / refactor / test / chore
- subject 用中文，动词开头，不超过 50 字
- 如果变更较复杂，在空行后加 1-3 行 body 说明（可选）
- 只输出 commit message 本身，不要任何解释或代码块

示例：
feat(auth): 添加 JWT 刷新 token 功能
fix(api): 修复用户列表分页计算错误
refactor(utils): 提取日期格式化为独立函数" \
  --bare --max-turns 5 2>/dev/null)

# 生成失败时静默退出，让用户自己写
if [ -z "$MSG" ]; then
  exit 0
fi

# ── 写入文件 ─────────────────────────────────────────────────────────────
# 把生成的消息写到文件开头，原有的 git 注释追加在后面
ORIGINAL=$(cat "$COMMIT_MSG_FILE")
printf "%s\n\n%s\n" "$MSG" "$ORIGINAL" > "$COMMIT_MSG_FILE"

echo "💡 已预填 commit message，保存退出即可（修改编辑器内容可覆盖）"
