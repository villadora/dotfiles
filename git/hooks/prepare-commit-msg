#!/bin/bash
# Git prepare-commit-msg hook - with Claude Code CLI
# ==========================================
# This hook uses Claude Code CLI to automatically generate commit messages
# when using `git commit` without providing a message.
#
# USAGE:
#   git commit                  - Generates commit message via Claude Code
#   git commit -m "message"     - Skips generation, uses provided message
#   git commit --amend          - Skips generation, amends previous commit
#
# CONFIGURATION:
#   Set language for commit message generation:
#     git config commit.language zh    - Use Chinese prompt
#     git config commit.language en    - Use English prompt (default)
#     git config --global commit.language zh  - Global Chinese setting
#
# INSTALLATION:
#   cp prepare-commit-msg .git/hooks/
#   chmod +x .git/hooks/prepare-commit-msg
#
# Gitmoji Convention:
#   This hook generates commit messages following the Gitmoji convention.
#   https://gitmoji.dev

COMMIT_MSG_FILE=$1
COMMIT_SOURCE=$2

# Skip if commit message is provided via -m flag or if amending
if [ "$COMMIT_SOURCE" = "message" ] || [ "$COMMIT_SOURCE" = "squash" ] || [ "$COMMIT_SOURCE" = "merge" ]; then
    exit 0
fi

# Get the staged changes diff
DIFF=$(git diff --cached)

# If no staged changes, exit
if [ -z "$DIFF" ]; then
    exit 0
fi

# Read language configuration: git config commit.language (zh|en), default to en
LANG_CONFIG=$(git config commit.language 2>/dev/null || echo "en")

# Common Gitmoji mappings (shared between languages)
GITMOJI_RULES="Common gitmoji mappings:
   - ✨ feat: New feature
   - 🐛 fix: Bug fix
   - 📝 docs: Documentation
   - 💄 style: Code style (formatting, semicolons, etc)
   - ♻️ refactor: Code refactoring
   - ⚡️ perf: Performance improvement
   - ✅ test: Adding/fixing tests
   - 🔧 build: Build system/dependencies
   - 👷 ci: CI configuration
   - 🔨 chore: General chores
   - ⏪️ revert: Reverting changes
   - 🔒️ security: Security improvements
   - 🚑️ critical: Critical hotfix
   - 🎨 art: Structure/code improvements
   - 🚀 deploy: Deployment
   - 🗑️ trash: Removing code/files"

# Select prompt based on language configuration
if [ "$LANG_CONFIG" = "zh" ] || [ "$LANG_CONFIG" = "chinese" ]; then
    SYSTEM_PROMPT="你是一个 commit 消息生成器。根据 Gitmoji 规范（https://gitmoji.dev）生成 commit 消息。

规则：
1. 使用最能代表更改类型的 gitmoji emoji 作为前缀
2. 遵循格式：<emoji> <type>(<scope>): <description>
3. ${GITMOJI_RULES}
4. 第一行保持在 50 个字符以内
5. 如有需要，在正文添加详细描述
6. 使用祈使语气（\"添加\" 而不是 \"已添加\"）
7. 关联相关 issue 编号（#123）
8. 只输出 commit 消息，不要解释或使用 markdown
9. 如果有多个更改，使用最重要的 emoji
10. 使用中文描述"
    echo "🌐 使用中文 prompt 生成 commit 消息"
else
    SYSTEM_PROMPT="You are a commit message generator. Generate commit messages following the Gitmoji convention (https://gitmoji.dev).

Rules:
1. Use a gitmoji emoji prefix that best represents the change type
2. Follow format: <emoji> <type>(<scope>): <description>
3. ${GITMOJI_RULES}
4. Keep first line under 50 characters
5. Add detailed description in body if needed
6. Use imperative mood (\"add\" not \"added\")
7. Reference issue numbers when relevant (#123)
8. Output ONLY the commit message, no explanations or markdown
9. If there are multiple changes, use the most significant emoji"
    echo "🌐 Using English prompt for commit message"
fi

USER_PROMPT="Generate a commit message for the following staged changes:\n\n\`\`\`diff\n${DIFF}\n\`\`\`"

# Call Claude Code CLI to generate commit message
GENERATED_MESSAGE=$(echo "$USER_PROMPT" | claude -p "$SYSTEM_PROMPT" --allowedTools "" 2>/dev/null)

if [ $? -eq 0 ] && [ -n "$GENERATED_MESSAGE" ]; then
    # Write the generated message to the commit message file
    echo "$GENERATED_MESSAGE" > "$COMMIT_MSG_FILE"
    echo "✨ Commit message generated by Claude Code"
else
    echo "⚠️ Failed to generate commit message, using default"
fi
